# Copy to .env (which is git-ignored) and fill in locally. NEVER commit .env.
#
# Which LLM backend the console uses: dryrun | ollama | anthropic
AIIT_PROVIDER=ollama

# Local model via Ollama (default: no data leaves the operator machine)
AIIT_OLLAMA_URL=http://127.0.0.1:11434
AIIT_OLLAMA_MODEL=qwen2.5:14b

# Anthropic API (only if your org has a signed BAA / HIPAA-ready org when PHI may be present)
# ANTHROPIC_API_KEY=sk-ant-...
AIIT_ANTHROPIC_MODEL=claude-opus-5-5
AIIT_ANTHROPIC_EFFORT=high

# Where the console keeps keys, cases, audit log (default: ~/.aiit/console)
# AIIT_CONSOLE_DIR=/secure/volume/aiit-console

# Optional passphrase that encrypts private keys at rest (recommended)
# AIIT_KEY_PASSPHRASE=change-me

# LAN mode shared enrollment token for aiit-console serve / aiit-agent push
# AIIT_SERVER_TOKEN=generate-a-long-random-string

# ---- Resilience and limits --------------------------------------------------
# Retries for every HTTP call the console or agent makes (0 disables)
# AIIT_HTTP_RETRIES=3
# Model request timeout in seconds (Ollama default 600, Anthropic default 600)
# AIIT_LLM_TIMEOUT=600
# AIIT_OLLAMA_TIMEOUT=600
# AIIT_LLM_MAX_RETRIES=2
# Ollama context window; the prompt budget is derived from it
# AIIT_OLLAMA_NUM_CTX=32768
# How many times the console feeds validation errors back to the model before giving up
# AIIT_PLAN_REPAIRS=1
# Keep Anthropic requests on the generally available, BAA-covered surface (no beta fallbacks)
# AIIT_HIPAA_MODE=1
# AIIT_ANTHROPIC_FALLBACKS=1

# ---- Audit chain alerting (console and agent) -------------------------------
# Command to run when the chain is broken (argv, JSON on stdin, no shell)
# AIIT_ALERT_CMD=/usr/local/bin/notify-helpdesk
# AIIT_ALERT_SYSLOG=siem.internal:514
# AIIT_ALERT_WEBHOOK=https://hooks.internal/aiit
# Minutes between chain checks while `aiit-console serve` runs
# AIIT_AUDIT_CHECK_MINUTES=60

# ---- Locations ------------------------------------------------------------
# AIIT_AGENT_DIR=/var/lib/aiit/agent
# Settings file for the console (default: <data dir>/.env). AIIT_CONSOLE_DIR cannot be set from inside it.
# AIIT_ENV_FILE=/secure/volume/aiit-console/.env
# Agent token from a file instead of the environment
# AIIT_SERVER_TOKEN_FILE=/etc/aiit/server.token

# Hosted providers (anthropic, openai, azure-openai) send redacted case text off this
# machine. Set to 1 only once a business associate agreement covers that provider;
# the same switch is --allow-hosted on `aiit-console diagnose`.
# AIIT_ALLOW_HOSTED=0
